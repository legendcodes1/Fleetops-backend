FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /workspace
COPY FleetOps.slnx dotnet-tools.json ./
COPY src ./src
COPY tests ./tests
RUN dotnet restore FleetOps.slnx && dotnet tool restore
RUN dotnet build FleetOps.slnx --no-restore -m:1 -p:UseSharedCompilation=false
CMD ["dotnet", "test", "FleetOps.slnx", "--no-build", "--no-restore", "-m:1", "--logger", "console;verbosity=normal"]
